{
  "name": "civic-priorities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:express --external:zod --external:compression",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build && npm run build:api",
    "preview": "vite preview",
    "server": "RUN_SERVER=true tsx server/index.ts",
    "start": "RUN_SERVER=true tsx server/index.ts",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "compression": "^1.8.2",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "thinking-orbs": "^0.3.1",
    "tsx": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.28.2",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
